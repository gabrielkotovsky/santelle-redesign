{
  "expo": {
    "name": "Santelle",
    "slug": "santelle-remastered",
    "version": "2.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "santelleremastered",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "buildNumber": "20",
      "splash": {
        "image": "./assets/images/background-mobile.jpg",
        "resizeMode": "cover",
        "backgroundColor": "#ffffff"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "processing",
          "fetch"
        ],
        "NSUserNotificationUsageDescription": "We use notifications to remind you when your test results are ready.",
        "ITSAppUsesNonExemptEncryption": false,
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.santelle.app.session-refresh"
        ]
      },
      "bundleIdentifier": "com.santelle.app",
      "runtimeVersion": "2.0.3"
    },
    "android": {
      "package": "com.santelle.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "versionCode": 4
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/background-mobile.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "santelle",
          "organization": "santelle"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.205692260060-4gs5501dlgprhsjob64g3a2hm1aur1ej"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e3fd9648-f76b-4760-b2f3-720ac4ac259e"
      }
    },
    "owner": "gabrielkotovsky",
    "updates": {
      "url": "https://u.expo.dev/e3fd9648-f76b-4760-b2f3-720ac4ac259e"
    }
  }
}
